    "@prisma/client": "^5.22.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "bullmq": "^5.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "imapflow": "^1.0.170",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "mailparser": "^3.7.1",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.2",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.3.6",
    "zod": "^4.1.12"

{
  "name": "facturasmart-mx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "workers": "tsx --env-file=.env src/workers/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:ocr": "vitest run tests/ticket-ocr.samples.test.ts",
    "services": "node scripts/dev-services.mjs",
    "db:push": "prisma db push"
  },
  "dependencies": {

# ─── Base de datos (PostgreSQL: Supabase / Neon / local) ───────────────
# `npm run services` levanta Postgres y Redis locales con estos valores
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facturasmart?schema=public"

# ─── Redis (BullMQ) ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── App ───────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Mientras no haya auth real, todas las acciones corren como este usuario
DEMO_USER_EMAIL="demo@facturasmart.app"

# ─── IA / OCR (Claude) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# Opcional: sobrescribe el modelo (default claude-opus-5-5)
AI_MODEL=""

# ─── Almacenamiento ────────────────────────────────────────────────────
# "local" (desarrollo: .data/storage + URLs firmadas por /api/storage) o "s3" (producción)
STORAGE_DRIVER="local"
# Secreto para firmar URLs locales: openssl rand -hex 32
STORAGE_SECRET=""
# S3-compatible (Supabase Storage, Cloudflare R2, AWS S3) cuando STORAGE_DRIVER="s3"
S3_ENDPOINT=""            # vacío para AWS; p.ej. https://<id>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET="facturasmart"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Email (Resend outbound + IMAP inbound) ────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="FacturaSmart MX <facturas@facturasmart.app>"
# Buzón que recibe las respuestas; debe soportar "plus addressing" (user+tag@dominio)
INBOUND_EMAIL_ADDRESS="facturas@facturasmart.app"
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""

# ─── WhatsApp (Twilio) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# URL pública exacta configurada en Twilio para el webhook (validación de firma)
TWILIO_WEBHOOK_URL="https://tu-dominio.com/api/webhooks/twilio"

# ─── Canales habilitados (los demás se saltan en el enrutador) ─────────
ENABLED_CHANNELS="EMAIL,WHATSAPP"
